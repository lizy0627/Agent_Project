# Copy this file to .env and fill in your own local values.
# Never commit a real API key to GitHub.

# Model service configuration.
API_KEY=your_model_api_key_here
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# You can switch to a faster available model here, for example qwen-turbo.
MODEL_NAME=qwen-plus
MODEL_TIMEOUT_SECONDS=60
MAX_AGENT_STEPS=8
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CONVERSATION_STORE=memory
CONVERSATION_DB_PATH=data/conversations.db
CONVERSATION_MAX_ROUNDS=30
# Optional SQLAlchemy URL for PostgreSQL/MySQL. Install the matching DB driver first.
# postgresql+psycopg://user:password@localhost:5432/agent
# mysql+pymysql://user:password@localhost:3306/agent
CONVERSATION_DATABASE_URL=
DOCUMENT_DB_PATH=data/documents.db
DOCUMENT_UPLOAD_MAX_BYTES=5242880
AUTH_ENABLED=false
AUTH_DB_PATH=data/auth.db
AUTH_JWT_SECRET=change-this-local-development-secret
AUTH_TOKEN_EXPIRE_MINUTES=1440
AUTH_DEV_USER_ID=__dev__
AUTO_OPEN_BROWSER=true
SEARCH_API_KEY=your_search_api_key_here
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_TIMEOUT_SECONDS=5
WEB_READER_TIMEOUT_SECONDS=5
SEARCH_WORKFLOW_READ_TOP_K=2
MEMORY_PATH=data/memories.json
MEMORY_SEARCH_LIMIT=5
MEMORY_RECENT_CONTEXT_LIMIT=6
MEMORY_VECTOR_ENABLED=false
MEMORY_VECTOR_TOP_K=5
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MCP_ENABLED=true
MCP_DEFAULT_SERVER=modelscope
MODELSCOPE_API_TOKEN=
MODELSCOPE_MCP_URL=http://127.0.0.1:8001/mcp
TOOL_TIMEOUT_SECONDS=60
