# Copy this file to .env and fill in your own local values.
# Never commit a real API key to GitHub.

DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# You can switch to a faster available model here, for example qwen-turbo.
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_TIMEOUT_SECONDS=60
TAVILY_API_KEY=your_tavily_api_key_here
WEB_SEARCH_PROVIDER=tavily
MCP_ENABLED=true
MCP_DEFAULT_SERVER=modelscope
MODELSCOPE_API_TOKEN=
MODELSCOPE_MCP_URL=http://127.0.0.1:8001/mcp
MCP_TIMEOUT_SECONDS=20
